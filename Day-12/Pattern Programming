# Square
for i in range(4):
    for j in range(4):
        print("*",end="")
    print()    
    
# Triangle
for i in range(1,6):
    for j in range(i):
        print("#",end="")
    print()        
    
# Inverted Triangle
for i in range (6,0,-1):
    for j in range(i):
        print("a",end="")
    print()        
    
 # Number pattern
for i in range (1,10):
     for j in range(1,i+1):
         print(j,end="") # uses j for diff no
     print()
    
 # Same number system
for i in range(1, 10):
     for j in range(i):
         print(i,end="") # uses i for same no
     print()        
